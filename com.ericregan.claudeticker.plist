<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ericregan.claudeticker</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/ericregan/claude-ticker/ClaudeTicker</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Deliberately false: clicking the panel's close button should stay closed
         until next login, not get resurrected by launchd. -->
    <key>KeepAlive</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/ericregan/claude-ticker/ticker.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/ericregan/claude-ticker/ticker.log</string>
</dict>
</plist>
